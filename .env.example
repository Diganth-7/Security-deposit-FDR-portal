# AICTE Security Deposit and FDR Management Portal (SIH26265) - environment template.
# Copy to .env and edit. Never commit .env. Contains no real secrets.

# ---- Mode: development | test | production ----
APP_ENV=development

# ---- Web server ----
PORT=3000
HOST=127.0.0.1
# Python used to start the API (use the virtualenv python, e.g. ./.venv/bin/python)
PYTHON_BIN=python3

# ---- Database ----
# Easiest for a demo: a local SQLite file (no setup).
DATABASE_URL=sqlite:///./aicte_fdr.db
# PostgreSQL (recommended for real use):
# DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/aicte_fdr_db
# If the database is unreachable the app STOPS with a clear error. Only for local convenience:
# ALLOW_SQLITE_FALLBACK=false

# ---- Security ----
# Required in production: 32+ random characters.  python -c "import secrets; print(secrets.token_urlsafe(48))"
# In development, leaving it empty generates a temporary key (logins reset on restart).
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
ALLOW_PRIVILEGED_SELF_REGISTRATION=false
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ---- Documents ----
MAX_UPLOAD_SIZE_BYTES=10485760
UPLOAD_STORAGE_DIR=storage/documents

# ---- Reminders ----
ENABLE_REMINDER_SCHEDULER=true
REMINDER_RUN_TIME=00:10
APP_TIMEZONE=Asia/Kolkata
ALLOW_REMINDER_DATE_OVERRIDE=false

# ---- Demo data (development only) ----
SEED_DEMO_DATA=true
# Shared password of the demo accounts. If empty, a random one is generated and printed once in the server log.
DEMO_PASSWORD=
# Show one-click demo logins on the login page (build-time; password is taken from VITE_DEMO_PASSWORD).
VITE_SHOW_DEMO_LOGINS=false
VITE_DEMO_PASSWORD=

# ---- Approval workflow permissions (comma separated roles) ----
APPROVAL_SUBMIT_ROLES_RENEWAL=INSTITUTION,ADMIN
APPROVAL_SUBMIT_ROLES_RELEASE=INSTITUTION,ADMIN
APPROVAL_SUBMIT_ROLES_FORFEITURE=OFFICER,ADMIN
APPROVAL_DECIDE_ROLES_RENEWAL=OFFICER,ADMIN
APPROVAL_DECIDE_ROLES_RELEASE=OFFICER,ADMIN
APPROVAL_DECIDE_ROLES_FORFEITURE=OFFICER,ADMIN
APPROVAL_REQUIRE_VERIFIED_DOCUMENT=true
FORFEITURE_REQUIRES_CONTRACT=true
